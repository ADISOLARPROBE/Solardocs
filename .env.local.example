# ==============================================================================
# SolarDocs — Environment Variables Example
# ==============================================================================
# Copy this file to `.env.local` for local development.
# In Railway (or other platforms), set these under Project Settings -> Variables.
#
# IMPORTANT SECURITY NOTICE:
# - Variables prefixed with `NEXT_PUBLIC_` are exposed to the browser client bundle.
# - NEVER put secret service role keys (e.g. `SUPABASE_SERVICE_ROLE_KEY`) in this file!
# - All database access strictly enforces Supabase Row-Level Security (RLS) via the publishable key.
# ==============================================================================

# Supabase Project URL (Optional in local dev; required in prod for Supabase metadata)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Publishable / Anon API Key (Optional in local dev; public client key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Yjs Real-Time Collaboration WebSocket Server URL (OPTIONAL)
# In unified single Railway deployment and default local dev, SolarDocs automatically
# connects to `/yjs` on the same deployed domain and port (ws:// locally, wss:// in production).
# Only set this if you are using an external dedicated collaboration server.
NEXT_PUBLIC_YJS_WEBSOCKET_URL=
